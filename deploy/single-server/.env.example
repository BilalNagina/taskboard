# Copy to /opt/taskboard/.env on the server and fill in. Never commit the real file.

# Public hostname. Its DNS A record must point at the server's static IP.
DOMAIN=taskboard.example.com

# GitHub owner in lowercase (container images are pulled from ghcr.io/<owner>/...).
GH_OWNER=your-github-user

# Image tag currently deployed. deploy.sh updates this line, so you don't edit it by hand.
TAG=latest

POSTGRES_USER=taskboard
POSTGRES_DB=taskboard
# Hex keeps the password safe inside a connection URL: openssl rand -hex 24
POSTGRES_PASSWORD=change-me

# Nightly backups (values come from `terraform output`).
BACKUP_BUCKET=your-backup-bucket
BACKUP_AWS_REGION=eu-west-3
BACKUP_AWS_ACCESS_KEY_ID=
BACKUP_AWS_SECRET_ACCESS_KEY=

# Task attachments: private S3 bucket and the app's IAM key (terraform output).
S3_BUCKET=your-attachments-bucket
S3_REGION=eu-west-3
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Reminder emails over SMTP. With Amazon SES: SMTP_USER is the app key id and SMTP_PASS
# is `terraform output -raw smtp_password`. Leave SMTP_HOST empty to log emails instead.
SMTP_HOST=email-smtp.eu-west-3.amazonaws.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Taskboard <reminders@taskboard.example.com>
